# Python cache
__pycache__/
*.py[cod]
*$py.class
*.class

# IDE & Editor
.idea/
.vscode/
*.swp
*.swo

# Testing cache
.pytest_cache/

# Large intermediate TIFF maps (generated automatically via scripts)
outputs/**/*.tif
outputs/*.tif

# Keep summary CSVs and high-res showcase PNG figures
!outputs/*.png
!outputs/*.csv
!outputs/final_results/*.png
