# Python cache
.venv/
__pycache__/
*.py[cod]
*$py.class
*.class

# IDE & Editor
.idea/
.vscode/
*.swp
*.swo

# Testing cache
.pytest_cache/

# Large intermediate TIFF maps (generated automatically via scripts)
outputs/**/*.tif
outputs/*.tif

# Keep summary CSVs and high-res showcase PNG figures
!outputs/*.png
!outputs/*.csv
!outputs/final_results/*.png

# Priority smoke test TIFFs for Duc
!outputs/smoke_test_tier1/*.tif
!outputs/smoke_test_bsds01_s2.zip

# Redundant zip archives in docs (raw LaTeX is already tracked)
docs/*.zip

# Local pre-migration backup
backup_pre_p0/
